{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["es2020"],
    "types": ["react", "react-native"]
  },
  "include": ["App.tsx", "src/**/*.ts"],
  "exclude": ["node_modules", "src/render", "__tests__"]
}
